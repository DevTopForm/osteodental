<div class="bg-light pb-60-100 pt-60-100">
    <div class="container">
        <div class="article-top bg-white mb-20">
            <div class="article-top__content">

                <a href="{$node->getUrl()}" class="article-top__back btn">
                    <svg fill="none" width="25" height="16">
                        <use xlink:href="/htdocs/assets/build/img/sprite.svg#arr"></use>
                    </svg>
                    ко всем статьям
                </a>
                <h1 class="h1">{$content->h1|default:$content->title}</h1>
                <div class="article-top__txt text">
                    {$content->announce}
                </div>
                <div class="article-top__info">
                    <span>{$content->date}</span>
                    <span>
                        <svg class="btn__icon" fill="none" width="20" height="20">
                          <use xlink:href="/htdocs/assets/build/img/sprite.svg#eye"></use>
                        </svg>
                            {$content->views}
                    </span>
                </div>
            </div>
            {if $content->image->id}
                <div class="article-top__img">
                    <img src="{$content->image->getLink()}" loading="eager" alt="" width="560" height="370">
                </div>
            {/if}
        </div>
        <div class="article">
            <div class="article__left">

                {if $content->text_1}
                    <div class="article-block text bg-white quote" id="anchor_text_1" data-menu="anchor_text_1">
                        {$content->text_1}
                    </div>
                {/if}
                
                <div class="tg-ban2">

                    <img class="tg-ban2__bg" loading="lazy" decoding="async" src="/htdocs/assets/build/img/bg-2.jpg" alt="" width="967" height="252">
                    <div class="tg-ban2__text">Если у вас есть вопросы, свяжитесь с нами</div>
                    <div class="tg-ban2__btns">

                        <div class="btn  btn--black btn--sm" data-action="request"><span>задать вопрос</span></div>
                        {if $params.link_tg}
                        <a href="{$params.link_tg}" target="_blank" rel="nofollow" class="btn  btn--bordered btn--sm">
{*                            <span>Написать в telegram или max</span>*}
                            <span>Написать в telegram</span>
                        </a>
                        {/if}
                    </div>
                </div>

                {if $content->text_2}
                    <div class="article-block text bg-white" id="anchor_text_2" data-menu="anchor_text_2">
                        {$content->text_2}
                    </div>
                {/if}

                {if $content->files}
                    <div class="article-block bg-white" id="anchor_files" data-menu="anchor_files">
                        <h2 class="h3 mb-20">{$content->files_title|default:'Материалы для скачивания'}</h2>
                        <div class="article-block__row">
                            {foreach from=$content->files item='file' name='files'}
                                {if $file.file_file->id}
                                    <a href="{$file.file_file->getLink()}" class="blog-ban " target="_blank">
                                        {if $file.file_image->id}
                                            <img class="blog-ban__img" src="{$file.file_image->getLink()}" alt="" loading="lazy" decoding="async" width="3357" height="1175">
                                        {/if}
                                        <svg fill="none" width="40" height="40">
                                            <use xlink:href="/htdocs/assets/build/img/sprite.svg#download"></use>
                                        </svg>
                                        <div class="blog-ban__txt">
                                            {$file.file_title}
                                        </div>
                                    </a>
                                {/if}
                            {/foreach}
                        </div>
                    </div>
                {/if}

                {if $content->faq}
                    <div class="article-block bg-white" id="anchor_faq" data-menu="anchor_faq">
                        <h2 class="h3 mb-20">{$content->faq_title|default:'Вопросы'}</h2>

                        {foreach from=$content->faq item='question' name='questions'}
                            <details class="faq-it anim-block anim-popup" data-animation="anim-popup-anim">
                                <summary class="faq-it__btn">
                                    <span class="faq-it__btn-text">{$question.faq_question}</span>
                                    <div class="faq-it__btn-svg btn">

                                        <svg class="btn__icon" fill="none" width="18" height="18">
                                            <use xlink:href="/htdocs/assets/build/img/sprite.svg#plus"></use>
                                        </svg>
                                    </div>
                                </summary>
                                <div class="faq-it__content">
                                    <div class="faq-it__content-inside">
                                        {$question.faq_answer}
                                    </div>
                                </div>
                            </details>
                        {/foreach}
                    </div>
                {/if}

                {if $content->cases}
                    <div class="article-block bg-white" id="anchor_cases" data-menu="anchor_cases">
                        {include file='module/results/default.tpl' content=$content->cases more=true alter=true is_slider=true title=$content->cases_title|default:"Случаи из практики"}
                    </div>
                {/if}

                {if $content->doctors}
                    <div class="article-block bg-white" id="anchor_doctors" data-menu="anchor_doctors">
                        <div class="article-block__sl">
                            <h2 class="h3 mb-20">{$content->doctors_title|default:'Врачи выполняющие услугу'}</h2>
                            <div class="doctors  js-why">
                                <div class="doctors__hide"></div>
                                <div class="doctors__slider js-why__slider ">
                                    <div class="doctors__wrapper swiper-wrapper">
                                        {foreach from=$content->doctors item='doctor' name='doctors'}
                                            {if !isset($delay)}
                                                {assign var="delay" value=0}
                                            {else}
                                                {assign var="delay" value=$delay+0.2}
                                            {/if}

                                            {include file="module/staff/include/slide.tpl" class="doctor-slide--sm swiper-slide" delay=$delay}
                                        {/foreach}
                                    </div>
                                </div>
                                <div class="doctors__arrs arrs">
                                    <button class="btn btn--bordered arr arr--left">
                                        <svg class="btn__icon" fill="none" width="90" height="46">
                                            <use xlink:href="/htdocs/assets/build/img/sprite.svg#arr"></use>
                                        </svg>
                                    </button>
                                    <button class="btn btn--bordered arr arr--right">
                                        <svg class="btn__icon" fill="none" width="90" height="46">
                                            <use xlink:href="/htdocs/assets/build/img/sprite.svg#arr"></use>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <a href="/staff" class="more-link">
                                <span>Все врачи</span>
                                <svg class="btn__icon" fill="none" width="25" height="17">
                                    <use xlink:href="/htdocs/assets/build/img/sprite.svg#arr2"></use>
                                </svg>
                            </a>
                        </div>
                    </div>
                {/if}

                {if $content->prices}
                    <div class="article-block bg-white" id="anchor_prices" data-menu="anchor_prices">

                        <h2 class="h3 mb-20">{$content->prices_title|default:'Цены'}</h2>
                        <div class="other">
                            {foreach from=$content->prices item='price' name='prices'}
                                {if $price->is_stock}
                                    {include file='module/prices/include/list_stock.tpl' content=$price}
                                {else}
                                    {include file='module/prices/include/list_element.tpl' content=$price}
                                {/if}
                            {/foreach}
                        </div>
                    </div>
                {/if}

                {if $content->sources}
                    <div class="article-block bg-white">
                        <h2 class="h3 mb-20">Источники</h2>
                        <ul class="sources bg-light">
                            {foreach from=$content->sources item='source' name='sources'}
                                <li><span>{$source.value}</span></li>
                            {/foreach}
                        </ul>
                    </div>
                {/if}
            </div>
            <div class="article__right">
                <ul class="article-menu">
                    {if $content->text_1 && $content->text_1_anchor}
