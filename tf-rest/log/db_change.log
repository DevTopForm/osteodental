2026-08-04T11:58:11+03:00 INFO (6): INSERT INTO `uploaded_files` (`title`, `node_type`, `src_name`, `name`, `mime`, `size`, `extension`, `description`, `crop`) VALUES ('', 'case', 'rest_6a71a9a30ee5c.jpg', 'rest_6a71a9a30ee5c_6a71a9.jpg', '', '215932', 'jpg', '', '')
2026-08-04T11:58:11+03:00 INFO (6): INSERT INTO `content_case` (`node`, `title`, `alias`, `image`, `weight`, `volume`, `what`, `task`, `solution`, `images`, `expert_title`, `expert_text`, `text`, `faq_q`, `faq_a`, `prices_title`, `cost`, `meta_title`, `meta_description`, `meta_keywords`, `public`, `sorter`) VALUES ('4226', 'Доставка личных вещей из Гуанчжоу в Москву: схема и сроки', 'dostavka-lichnykh-veshhejj-iz-guanchzhou-v-moskvu-skhema-i-sroki', '2628', '2,4 тонны', '11 м³', 'Личные вещи: одежда, книги, кухонная утварь, электроника', 'Заказчик длительное время проживал в Гуанчжоу и решил вернуться в Москву. Накопилось значительное количество личных вещей, которые требовалось перевезти. Сложность заключалась в том, что среди вещей были предметы с ограничениями к ввозу: техника, косметика, продукты. Заказчику нужна была полная таможенная очистка и доставка до двери. Он обратился к нам с просьбой организовать перевозку из Гуанчжоу в Москву с гарантией сохранности и в разумные сроки.', 'Мы разработали схему мультимодальной перевозки: автомобильный транспорт от двери в Гуанчжоу до порта Наньша, далее морская линия до Владивостока, затем железнодорожным контейнером до Москвы. Организовали консолидацию груза в одном контейнере, провели упаковку и опись. Оформили все необходимые документы, включая таможенную декларацию. После прибытия в порт Владивостока груз был перегружен на контейнерный поезд и доставлен на терминал в Москве, затем развезён по адресу. Срок доставки составил 35 дней. Таможенное оформление прошло без задержек, все сборы оплачены.', '2628;2629', 'Растаможка личных вещей — главный риск', 'Даже при мультимодальной перевозке ключевой нюанс — таможенное оформление: личные вещи часто вызывают вопросы у инспектора. Решение — заранее составить подробную опись с фотофиксацией каждой коробки, как мы сделали для клиента. Это ускоряет процесс и снижает риск претензий. Также учтите, что при наличии продуктов обязателен фитосанитарный контроль во Владивостоке.', '<h2>Результат</h2><p>Гуанчжоу — крупнейший транспортный узел Южного Китая, порт Наньша входит в десятку крупнейших контейнерных портов мира. Здесь сосредоточены производства электроники, текстиля, мебели и многих других товаров, что делает город ключевой точкой экспорта. Через Гуанчжоу проходят основные морские торговые маршруты в Европу и Россию, а также развитая сеть железных дорог и аэропорт Baiyun. Для логистических компаний это идеальная база для консолидации сборных грузов.</p><h2>Как мы выполнили задачу</h2><p>Клиент обратился к нам с задачей перевезти личные вещи из Гуанчжоу в Москву. Мы выбрали оптимальный маршрут и схему, которая сочетает в себе экономичность и разумные сроки.</p><h3>Шаг 1: Консолидация и упаковка груза в Гуанчжоу</h3><p>Мы организовали выезд упаковщиков по адресу заказчика. Все вещи были рассортированы, упакованы в коробки, и составлена подробная опись с фотофиксацией. Это позволило правильно задекларировать товары и избежать претензий при таможне.</p><h3>Шаг 2: Автомобильная доставка в порт Наньша</h3><p>После упаковки груз на грузовике перевезли в терминал порта Наньша. Расстояние — 80 километров, доставка заняла 1 день. На терминале груз был помещён в 20-футовый контейнер и опломбирован.</p><h3>Шаг 3: Морская перевозка до Владивостока</h3><p>Контейнер был погружен на судно, следующее по маршруту Гуанчжоу — Владивосток. Транзитное время составило 14 дней. На время морского перехода груз был застрахован.</p><h3>Шаг 4: Перегрузка на железную дорогу во Владивостоке</h3><p>По прибытии во Владивосток контейнер был выгружен и перемещён на контейнерный терминал для отправки поездом. Здесь прошёл ветеринарный и фитосанитарный контроль для продуктов, если они были.</p><h3>Шаг 5: Железнодорожная доставка до Москвы</h3><p>Контейнер был включён в состав контейнерного поезда, следующего во Владивосток — Москва. Время в пути составило 16 дней. Поезд следует по Транссибирской магистрали.</p><h3>Шаг 6: Таможенное оформление в Москве</h3><p>После прибытия на станцию назначения мы провели таможенное оформление личных вещей. Подали декларацию, оплатили пошлины и НДС. Благодаря предварительной описи процесс занял всего 1 день.</p><h3>Шаг 7: Доставка до двери</h3><p>На следующий день контейнер был растаможен, и наш автомобиль доставил вещи по адресу заказчика. Выгрузка и подъём на этаж были включены в стоимость. Клиент получил груз в полной сохранности.</p>', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:126:\"Сколько времени занимает доставка личных вещей из Гуанчжоу в Москву?\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:96:\"Как обеспечивается сохранность груза при перевозке?\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:116:\"Какие документы нужны для таможенного оформления личных вещей?\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:105:\"Можно ли отправить вместе с вещами продукты или растения?\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:96:\"Включена ли доставка до двери в стоимость перевозки?\";}}', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:610:\"Общий срок доставки составляет около 33–35 дней. Выезд упаковщиков и доставка в порт Наньша занимают 1 день. Морской переход до Владивостока — 14 дней. Затем контейнер отправляется поездом до Москвы, что занимает ещё 16 дней. Таможенное оформление и доставка до двери добавляют 1–2 дня. Точные сроки зависят от расписания судов и поездов.\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:633:\"Мы используем профессиональную упаковку: сортируем вещи, укладываем в прочные коробки, составляем опись с фотофиксацией. Груз помещается в опломбированный контейнер, что исключает несанкционированный доступ. На время морского перехода оформляется страховка. Мультимодальная схема с минимальными перегрузками также снижает риск повреждений.\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:630:\"Основной документ — подробная опись груза с фотографиями, которую мы готовим при упаковке. Для физического лица потребуются копия паспорта и заполненная пассажирская таможенная декларация. Мы самостоятельно подаём декларацию, рассчитываем и оплачиваем пошлины и НДС. Благодаря подготовленной описи таможня проходит быстро, обычно за 1 день.\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:611:\"Да, но для продуктов питания и товаров растительного/животного происхождения требуется прохождение ветеринарного и фитосанитарного контроля. Эти процедуры мы организуем при перегрузке во Владивостоке, как описано в кейсе. Рекомендуем заранее сообщать о наличии таких грузов, чтобы правильно подготовить разрешительные документы.\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:588:\"Да, в нашем сервисе доставка до двери включена. После прохождения таможни в Москве мы организуем вывоз контейнера с терминала на грузовом автомобиле и привозим вещи прямо по указанному адресу. Выгрузка и подъём на этаж также входят в стоимость. Клиенту не нужно беспокоиться о дополнительных расходах на последнем этапе.\";}}', '', '', 'Перевозка личных вещей из Гуанчжоу в Москву: этапы и сроки', 'Полный процесс перевозки личных вещей из Гуанчжоу в Москву: упаковка, морская и ж/д доставка, таможня. Заказывайте!', 'перевозка личных вещей, Гуанчжоу, Москва, морская перевозка, железнодорожная доставка, таможенное оформление, контейнерные перевозки, логистика из Китая, сборные грузы, доставка до двери', '0', '1')
