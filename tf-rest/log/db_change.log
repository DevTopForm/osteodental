2026-09-30T12:20:22+03:00 INFO (6): INSERT INTO `content_faq` (`node`, `title`, `answer`, `public`, `sorter`) VALUES ('4180', 'Сколько стоит доставка детских самокатов из Китая?', 'Стоимость зависит от веса груза, объёма, способа перевозки и типа самокатов. Для расчёта используется объёмный вес, так как самокаты занимают много места при небольшом весе. Тарифы начинаются от 3,20 $/кг. Точную цену мы рассчитаем после получения параметров партии.', '1', '0')
