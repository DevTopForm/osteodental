2026-08-04T11:59:12+03:00 INFO (6): INSERT INTO `content_case` (`node`, `title`, `alias`, `image`, `weight`, `volume`, `what`, `task`, `solution`, `images`, `expert_title`, `expert_text`, `text`, `faq_q`, `faq_a`, `prices_title`, `cost`, `meta_title`, `meta_description`, `meta_keywords`, `public`, `sorter`) VALUES ('4226', 'Доставка одежды из Гуанчжоу в Москву: логистика без сюрпризов', 'dostavka-odezhdy-iz-guanchzhou-v-moskvu-logistika-bez-sjurprizov', '2636', '5 тонн', '30 м³', 'Модная одежда: куртки, платья, джинсы, трикотаж.', 'Заказчик — владелец розничного магазина одежды в Москве. Ему требовалось организовать доставку новой коллекции из Гуанчжоу на склад в Москве. В связи с приближающимся сезоном были жёсткие сроки: груз должен был прибыть не позднее чем через 35 дней. Также заказчик нуждался в полном таможенном оформлении и консолидации товаров от нескольких поставщиков.', 'Мы разработали оптимальный маршрут: забор грузов от трёх поставщиков в Гуанчжоу, консолидация на нашем складе, экспортное оформление, морская перевозка из Шанхая в Санкт-Петербург (контейнер 40 футов), импортное оформление с уплатой пошлин и автодоставка до склада заказчика в Москве. Общий срок составил 32 дня, что на 3 дня раньше планируемого. Все товары прошли сертификацию, потери и повреждения отсутствовали.', '2636;2637', 'Выбор порта отправки: не всегда ближайший', 'Многие считают, что груз из Гуанчжоу следует отправлять через порт Наньша. Однако на практике ставки морского фрахта и частота судозаходов из Шанхая часто выгоднее. Мы доставили товар автотранспортом до Шанхая и сэкономили клиенту около 10% стоимости перевозки при том же сроке. Всегда сравнивайте варианты фидерных и магистральных портов.', '<h2>Гуанчжоу — логистический центр Китая</h2>\nГуанчжоу — один из крупнейших торговых центров Китая и мира. Здесь расположены тысячи фабрик по пошиву одежды, обуви и аксессуаров. Благодаря развитой логистической инфраструктуре город является главными воротами для экспорта товаров лёгкой промышленности. Из порта Наньша и международного аэропорта Байюнь грузы отправляются во все уголки планеты. В Гуанчжоу работают многочисленные терминалы и склады консолидации, что позволяет формировать сборные партии для доставки в Россию. Знание местных особенностей и связей с перевозчиками помогает нам быстро и надёжно организовывать перевозки.\n\n<h2>Как мы выполнили доставку</h2>\nДоставка одежды из Гуанчжоу — типовая, но ответственная задача. Мы взялись за неё в конце марта, когда заказчик обратился с просьбой привезти партию к началу мая. Рассказываем, как проходила работа.\n\n<h3>1. Забор груза</h3>\nНаши представители посетили три фабрики в Гуанчжоу, проверили упаковку, маркировку и соответствие заказанным позициям. Забрали товар на микроавтобусе и привезли на склад консолидации.\n\n<h3>2. Консолидация и упаковка</h3>\nНа складе мы объединили груз в единую партию, пересчитали, упаковали в картонные коробки и паллеты. Составили упаковочный лист и сформировали 40-футовый контейнер.\n\n<h3>3. Экспортное оформление</h3>\nПодготовили экспортную декларацию, сертификаты происхождения и другие документы. Прошли таможенный досмотр. Особых сложностей не возникло, так как одежда не является подакцизным товаром.\n\n<h3>4. Морская перевозка</h3>\nГруз был доставлен автотранспортом из Гуанчжоу в порт Шанхай, где его погрузили на контейнеровоз. Морской путь до Санкт-Петербурга занял около 25 дней. Мы отслеживали движение судна и информировали заказчика.\n\n<h3>5. Импортное оформление</h3>\nПосле прибытия в порт мы организовали растаможку. Оплатили пошлины и НДС, подали декларации, прошли ветеринарный и фитосанитарный контроль (для текстиля не нужен). Все процедуры заняли 3 дня.\n\n<h3>6. Доставка до склада</h3>\nВывезли контейнер из порта, перегрузили в фуру и доставили до склада в Москве. Совместно с заказчиком проверили целостность упаковки и количество мест. Груз был передан в срок.', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:76:\"Как вы забираете груз с фабрик в Гуанчжоу?\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:86:\"Как происходит консолидация и упаковка товара?\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:113:\"Сколько времени занимает морская перевозка из Китая в Россию?\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:92:\"Какие документы нужны для таможенного оформления?\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:71:\"Вы доставляете груз до склада в Москве?\";}}', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:366:\"Наши представители лично посещают фабрики, проверяют упаковку, маркировку и соответствие заказу. Затем груз забирается микроавтобусом и доставляется на склад консолидации для дальнейшей обработки.\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:351:\"На складе мы объединяем грузы от разных поставщиков в единую партию, пересчитываем, упаковываем в картонные коробки и паллеты. Составляем упаковочный лист и формируем контейнер для отправки.\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:361:\"Морская перевозка из порта Шанхай в Санкт-Петербург занимает около 25 дней. Также возможна доставка в другие порты России. Мы постоянно отслеживаем движение судна и информируем заказчика о статусе.\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:447:\"Для экспорта из Китая необходима экспортная декларация, сертификаты происхождения, упаковочный лист. При импорте в Россию подаём таможенную декларацию, оплачиваем пошлины и НДС. Для одежды ветеринарный и фитосанитарный контроль не требуется.\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:358:\"Да, после растаможки контейнер вывозится из порта, груз перегружается в фуру и доставляется на склад заказчика в Москве. Совместно с получателем проверяем целостность упаковки и количество мест.\";}}', '', '', 'Доставка одежды из Гуанчжоу в Москву: этапы и опыт', 'Как мы доставили партию одежды из Гуанчжоу в Москву. Подробно о каждом этапе: забор, консолидация, море, растаможка. Узнайте, как мы работаем!', 'доставка из гуанчжоу, логистика китай, перевозка одежды, сборный груз, морская доставка, растаможка, таможенное оформление, консолидация грузов, доставка в москву, транспортная компания', '0', '1')
