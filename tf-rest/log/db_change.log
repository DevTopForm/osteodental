2026-08-04T11:59:24+03:00 INFO (6): INSERT INTO `uploaded_files` (`title`, `node_type`, `src_name`, `name`, `mime`, `size`, `extension`, `description`, `crop`) VALUES ('', 'case', 'rest_6a71a9ec2bd2b.jpg', 'rest_6a71a9ec2bd2b_6a71a9.jpg', '', '202437', 'jpg', '', '')
2026-08-04T11:59:24+03:00 INFO (6): INSERT INTO `content_case` (`node`, `title`, `alias`, `image`, `weight`, `volume`, `what`, `task`, `solution`, `images`, `expert_title`, `expert_text`, `text`, `faq_q`, `faq_a`, `prices_title`, `cost`, `meta_title`, `meta_description`, `meta_keywords`, `public`, `sorter`) VALUES ('4226', 'Доставка обуви из Шанхая в Москву: логистика под ключ', 'dostavka-obuvi-iz-shankhaja-v-moskvu-logistika-pod-kljuch', '2650', '4,5 тонны', '18 м³', 'Обувь: кроссовки, туфли, ботинки (4200 пар)', 'Клиент, владелец сети магазинов обуви, обратился с задачей доставить партию из 4200 пар обуви из Шанхая в Москву к началу осеннего сезона. Груз был собран на складе в Шанхае, требовалось организовать вывоз, экспортное оформление, морскую перевозку и последующую доставку до склада в Москве. Ключевыми условиями были соблюдение сроков в 30 дней и сохранность упаковки. Также клиент запросил полное таможенное сопровождение с расчётом платежей.', 'Для решения задачи мы выбрали мультимодальный маршрут: автотранспорт от склада в Шанхае до порта Нинбо, далее контейнерная морская перевозка до Санкт-Петербурга, затем автодоставка в Москву. Это позволило уложиться в 28 дней. Таможенное оформление выполнили в Москве, подав декларацию после прибытия. Провели сертификацию обуви, подобрали код ТН ВЭД и минимизировали пошлины. Груз доставлен на склад клиента без повреждений, все коробки соответствовали упаковочным листам. Итоговая стоимость перевозки оказалась на 12% ниже бюджета клиента.', '2650;2651', 'Обувь: растаможка требует сертификатов', 'Коллекция обуви — товар, подлежащий обязательной сертификации по ТР ТС 019/2011. Чтобы избежать задержек на таможне, заранее запрашивайте у поставщика сертификаты соответствия и проверяйте маркировку на коробках. Мы передали документы в декларацию до прибытия груза, что позволило выпустить товар за два дня.', 'Клиент обратился к нам с нестандартной задачей: в сжатые сроки доставить коллекцию обуви из Шанхая в Москву. Рассказываем, как мы организовали перевозку и с какими сложностями столкнулись.\n\n<h2>Результат</h2>\n\nШанхай — крупнейший портовый и логистический узел Китая, через который проходит около 25% всех морских экспортных грузов страны. Город известен производством обуви и текстиля, здесь расположены тысячи фабрик, работающих на экспорт. Благодаря развитой инфраструктуре, включая порт Яншань и аэропорт Пудун, Шанхай является идеальной точкой для старта международной доставки. Логистические компании предлагают гибкие варианты консолидации и отправки грузов по всему миру.\n\n<h2>Схема выполнения задачи</h2>\n\nМы составили маршрут из четырёх этапов, чтобы оптимизировать сроки и стоимость. Ниже — пошаговая схема.\n\n<h3>1. Забор груза в Шанхае</h3>\n\nМы подали машину на склад поставщика, провели погрузку 4200 коробок, опломбировали их и оформили экспортные документы. Проверили соответствие упаковки требованиям морской перевозки.\n\n<h3>2. Доставка до порта Нинбо</h3>\n\nГруз перевезли в порт Нинбо, который находится в 200 км от Шанхая. Это позволило разгрузить контейнерный терминал и ускорить отправку. Там консолидировали товар в 20-футовый контейнер.\n\n<h3>3. Морская перевозка до Санкт-Петербурга</h3>\n\nКонтейнер загрузили на судно линейного оператора. Время в пути составило 24 дня, включая прохождение Суэцкого канала. Мы отслеживали судно онлайн и информировали клиента.\n\n<h3>4. Таможенное оформление в Москве</h3>\n\nПосле прибытия в порт Санкт-Петербурга контейнер перевезли на таможенный терминал в Москве. Мы подали электронную декларацию, предоставили сертификаты происхождения и провели платежи. Таможня выпустила товар за 2 дня.\n\n<h3>5. Доставка на склад клиента</h3>\n\nПосле выпуска груз доставили на склад в Москве. Выгрузили коробки, проверили целостность и передали клиенту полный пакет документов.', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:127:\"Сколько времени занимает доставка из Шанхая до Москвы по такой схеме?\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:123:\"Почему груз повезли в порт Нинбо, а не отправили напрямую из Шанхая?\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:119:\"Какие документы нужны для таможенного оформления обуви из Китая?\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:125:\"Как вы обеспечиваете сохранность груза при такой сложной перевозке?\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:141:\"Можно ли заказать срочную доставку других товаров из Китая по такой же схеме?\";}}', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:494:\"Общий срок зависит от этапов. В данном кейсе морская перевозка до Санкт-Петербурга заняла 24 дня. Забор груза, доставка в Нинбо и консолидация — до 3 дней. Таможенное оформление в Москве — 2 дня после прибытия контейнера. Итоговая доставка до склада клиента — около 30 дней.\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:452:\"Порт Нинбо находится в 200 км от Шанхая и позволяет разгрузить перегруженный контейнерный терминал Шанхая. Это ускоряет отправку и снижает риски задержек. Консолидация в Нинбо также дала возможность оптимизировать загрузку 20-футового контейнера.\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:503:\"Необходимы экспортные документы от поставщика (инвойс, упаковочный лист), сертификаты происхождения для подтверждения страны-изготовителя. Мы подаем электронную декларацию и проводим таможенные платежи. В кейсе таможня выпустила товар за 2 дня после подачи полного пакета.\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:537:\"На каждом этапе мы контролируем целостность: проверяем упаковку на соответствие морской перевозке, опломбируем груз после погрузки, используем надежную консолидацию в контейнере. Во время морской перевозки отслеживаем судно онлайн. После доставки передаем клиенту груз с проверкой коробок.\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:511:\"Да, схема адаптируется под разные грузы и сроки. Мы работаем со всеми типами товаров из Китая, включая текстиль и обувь. Для ускорения можем предложить авиаперевозку, но морская оптимальна по стоимости для крупных партий. Рассчитываем оптимальный маршрут под требования клиента.\";}}', '', '', 'Доставка обуви из Шанхая в Москву: опыт логистики', 'Как мы организовали перевозку коллекции обуви из Шанхая в Москву за 24 дня. Морская логистика, таможня, доставка. Узнайте подробности.', 'доставка обуви, перевозка из Китая, морская логистика, Шанхай Москва, таможенное оформление, контейнерные перевозки, грузоперевозки, логистическая компания', '0', '1')
