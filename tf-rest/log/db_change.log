2026-08-04T12:15:33+03:00 INFO (6): INSERT INTO `uploaded_files` (`title`, `node_type`, `src_name`, `name`, `mime`, `size`, `extension`, `description`, `crop`) VALUES ('', 'case', 'rest_6a71adb544c0f.jpg', 'rest_6a71adb544c0f_6a71ad.jpg', '', '178475', 'jpg', '', '')
2026-08-04T12:15:33+03:00 INFO (6): INSERT INTO `content_case` (`node`, `title`, `alias`, `image`, `weight`, `volume`, `what`, `task`, `solution`, `images`, `expert_title`, `expert_text`, `text`, `faq_q`, `faq_a`, `prices_title`, `cost`, `meta_title`, `meta_description`, `meta_keywords`, `public`, `sorter`) VALUES ('4226', 'Доставка обуви из Гуанчжоу в Москву: 28 дней и полный таможенный сервис', 'dostavka-obuvi-iz-guanchzhou-v-moskvu-28-dnejj-i-polnyjj-tamozhennyjj-servis', '2654', '12 тонн', '45 м³', 'Обувь (кроссовки, туфли, ботинки) в ассортименте', 'Владелец розничного магазина обуви в Москве обратился в нашу компанию с задачей организовать полный цикл доставки партии обуви из Гуанчжоу (Китай) в Москву. Требовалось перевезти 12 тонн груза объемом 45 м³ (10 000 пар обуви) в течение 30 дней, включая таможенное оформление, оплату пошлин и доставку до склада заказчика. Груз необходимо было принять на фабрике в Гуанчжоу, упаковать в соответствии с международными требованиями и обеспечить сохранность при перевозке.', 'Мы предложили схему мультимодальной перевозки с использованием морского и автомобильного транспорта. Груз был забортован со склада поставщика в Гуанчжоу, доставлен в порт Наньша, откуда морским судном отправлен в Санкт-Петербург. После прохождения таможенного оформления в Москве, партия обуви была доставлена на склад заказчика. Общий срок перевозки составил 28 дней. Заказчик получил полный пакет документов и сертификатов, а также консолидированный отчет по расходам.', '2654;2655', 'Сертификаты соответствия на обувь требуют подготовки', 'При импорте обуви в РФ оформление сертификатов соответствия — частый источник задержек. Чтобы избежать простоев, заранее проверьте требования к маркировке и подготовьте пакет документов вместе с таможенным представителем. В нашем случае совместная подготовка декларации с клиентом позволила пройти таможню без задержек.', '<h2>Результат: о городе Гуанчжоу</h2>\nГуанчжоу — крупнейший промышленный и логистический центр Южного Китая. Город с населением более 15 миллионов человек является важнейшим узлом в мировой торговле обувью: здесь расположены тысячи фабрик, выпускающих ежегодно миллиарды пар. Особенно развито производство в районе Байюнь и соседнем Шилине. Порт Гуанчжоу (Наньша) — один из самых загруженных в мире, обеспечивает прямой выход на международные контейнерные линии. Благодаря развитой сети автодорог и ж/д сообщения Гуанчжоу служит транзитной точкой для грузов из провинции Гуандун и всего юга Китая.\n\n<h2>Схема выполнения задачи и детали</h2>\nДля выполнения задачи была выбрана схема мультимодальной перевозки с использованием морского и автомобильного транспорта. Это позволило сократить расходы на авиадоставку и обеспечить надёжность для крупной партии обуви. Организация проходила в несколько этапов, каждый из которых требовал внимательного контроля.\n\n<h3>1. Приёмка и упаковка груза на фабрике</h3>\nМы осуществили выезд на фабрику в Гуанчжоу, где проверили качество продукции, пересчитали пары обуви, организовали переупаковку в экспортные картонные коробки с маркировкой. Все 10 000 пар были загружены в один 40-футовый контейнер объёмом 67 м³. При этом занятость составила 45 м³, а вес — 12 тонн. Оформили экспортную декларацию и упаковочный лист.\n\n<h3>2. Доставка до порта Наньша</h3>\nКонтейнер был перевезён на грузовом автомобиле до терминала порта Наньша (около 120 км). Мы заблаговременно забронировали место на контейнерном судне, работающем на линии Китай–Санкт-Петербург. На терминале провели обязательное взвешивание и радиационный контроль, после чего контейнер был принят к морской перевозке.\n\n<h3>3. Морская перевозка и транзитное время</h3>\nСудно отправилось из Наньша через Южно-Китайское море и Суэцкий канал в Балтийск. Время в пути составило 24 суток. Мы отслеживали движение контейнера по системе слежения, оперативно получали данные о местонахождении и статусе. Погодные условия и заходы в промежуточные порты не вызвали задержек.\n\n<h3>4. Прибытие в Санкт-Петербург и таможенный транзит в Москву</h3>\nПосле разгрузки судна в порту Санкт-Петербурга контейнер был помещён под процедуру таможенного транзита до Москвы. Мы подали транзитную декларацию, и контейнер был отправлен на таможенный пост в Москве. Это позволило сэкономить время и избежать процедур в порту.\n\n<h3>5. Таможенное оформление в Москве</h3>\nВ Москве мы подали полный пакет документов: инвойс, контракт, сертификаты происхождения, сертификат соответствия на обувь. Специалисты проверили таможенную стоимость, скорректировали её с учётом рыночных цен. Пошлина и НДС были оплачены заказчиком. После выпуска товара контейнер был направлен на склад временного хранения.\n\n<h3>6. Доставка до склада заказчика</h3>\nМы организовали доставку контейнера на склад в Москве на грузовом автомобиле с гидравлическим бортом. Груз был выгружен, пересчитан, проверен на целостность упаковки. Заказчик принял товар без замечаний, подписав транспортную накладную и акт приёма-передачи. Вся схема заняла 28 дней с момента забора груза.\n\nВ процессе выполнения возникали нюансы с оформлением сертификатов соответствия, но мы заранее проконсультировали клиента и совместно подготовили декларацию. Это позволило избежать задержек на таможне.', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:133:\"Какой срок доставки груза из Гуанчжоу в Москву по мультимодальной схеме?\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:115:\"Какие документы потребуются для таможенного оформления обуви?\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:111:\"Как обеспечивается сохранность груза при морской перевозке?\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:123:\"Можно ли сэкономить, выбрав мультимодальную перевозку вместо авиа?\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:101:\"Что делать, если нет сертификата соответствия на обувь?\";}}', 'a:5:{i:0;a:2:{s:2:\"id\";i:1;s:5:\"value\";s:439:\"Полный цикл от забора на фабрике до доставки на склад в Москве занимает около 28 дней. Это включает 24 дня морской перевозки и несколько дней на наземные этапы и таможню. Мы отслеживаем контейнер онлайн, что позволяет минимизировать задержки.\";}i:1;a:2:{s:2:\"id\";i:2;s:5:\"value\";s:382:\"Необходимы инвойс, контракт, упаковочный лист, сертификаты происхождения и соответствия. Мы помогаем заранее подготовить декларацию, чтобы избежать задержек. Также требуется оплата пошлины и НДС заказчиком.\";}i:2;a:2:{s:2:\"id\";i:3;s:5:\"value\";s:446:\"Груз упаковывается в прочные экспортные коробки, загружается в 40-футовый контейнер с соблюдением всех норм. Мы контролируем погрузку, взвешивание и радиационный контроль в порту. Система слежения позволяет отслеживать контейнер на всем пути.\";}i:3;a:2:{s:2:\"id\";i:4;s:5:\"value\";s:403:\"Да, мультимодальная схема значительно дешевле авиадоставки, особенно для крупных партий. В нашем случае перевозка 10 000 пар обуви заняла 28 дней, но расходы были в разы ниже. Это оптимальный вариант для регулярных поставок.\";}i:4;a:2:{s:2:\"id\";i:5;s:5:\"value\";s:441:\"Мы заранее консультируем клиента по требованиям и помогаем подготовить декларацию. В данном проекте мы совместно оформили все документы до отправки, что исключило простои. Рекомендуем начинать оформление сразу после заключения контракта.\";}}', '', '', 'Доставка обуви из Гуанчжоу в Москву: схема мультимодальной перевозки', 'Как мы доставили 10 000 пар обуви из Гуанчжоу в Москву за 28 дней: приёмка, морская перевозка, таможня. Узнайте подробности и закажите логистику!', 'грузоперевозки из Китая, доставка обуви, мультимодальные перевозки, морская перевозка, таможенное оформление, Гуанчжоу, Москва, логистика, контейнерные перевозки, Наньша', '0', '1')
